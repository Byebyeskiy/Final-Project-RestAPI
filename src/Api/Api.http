@Api_HostAddress = http://localhost:5179

GET {{Api_HostAddress}}/listings
Accept: application/json

###

POST {{Api_HostAddress}}/listings
Content-Type: application/json

{
  "title": "Vintage Denim Jacket",
  "price": 750.00,
  "availableSince": "2026-11-01T00:00:00Z",
  "category": 0
}

###

@listingId = replace-with-id-from-create-response

POST {{Api_HostAddress}}/listings/{{listingId}}/approve

###

POST {{Api_HostAddress}}/listings/{{listingId}}/reject
Content-Type: application/json

{
  "reason": "Add a clearer description"
}
